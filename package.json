{
  "name": "omp-toolkit",
  "version": "0.3.0",
  "private": true,
  "description": "Unofficial OMP toolkit for provider usage, Gemini route health, and reliability history, with optional Orca integration.",
  "license": "MIT",
  "author": "OMP Toolkit contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/kamishino/omp-toolkit.git"
  },
  "homepage": "https://github.com/kamishino/omp-toolkit#readme",
  "bugs": {
    "url": "https://github.com/kamishino/omp-toolkit/issues"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3",
  "keywords": [
    "omp",
    "orca",
    "bun",
    "cli",
    "provider-usage",
    "gemini",
    "deepseek",
    "windows"
  ],
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:desktop": "bun scripts/build.ts --desktop",
    "desktop": "bun scripts/widget.ts",
    "desktop:preview": "bun scripts/widget.ts --preview",
    "desktop:once": "bun scripts/widget.ts --once",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc -p apps/desktop/tsconfig.json --noEmit",
    "format": "biome format --write .",
    "check": "biome check . && tsc --noEmit && tsc -p apps/desktop/tsconfig.json --noEmit && bun test && bun scripts/check-tokens.ts",
    "widget": "bun scripts/widget.ts",
    "install:omp": "bun scripts/build.ts --no-desktop && bun scripts/install.ts",
    "monitor": "bun scripts/monitor.ts",
    "monitor:orca": "bun scripts/orca-monitor.ts",
    "reliability:report": "bun scripts/reliability-report.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/bun": "latest",
    "@types/node": "latest",
    "@types/pngjs": "^6.0.5",
    "colorjs.io": "^0.7.1",
    "pngjs": "^7.0.0",
    "typescript": "latest"
  }
}
