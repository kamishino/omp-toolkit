{
  "name": "omp-toolkit",
  "version": "0.5.0",
  "private": true,
  "description": "Unofficial OMP toolkit for provider usage, Gemini route health, and reliability history, with optional Orca integration.",
  "license": "MIT",
  "author": "OMP Toolkit contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/kamishino/omp-toolkit.git"
  },
  "homepage": "https://github.com/kamishino/omp-toolkit#readme",
  "bugs": {
    "url": "https://github.com/kamishino/omp-toolkit/issues"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3",
  "keywords": [
    "omp",
    "orca",
    "bun",
    "cli",
    "provider-usage",
    "gemini",
    "deepseek",
    "windows"
  ],
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun scripts/build/build.ts",
    "build:desktop": "bun scripts/build/build.ts --desktop",
    "desktop": "bun scripts/desktop/widget.ts",
    "desktop:preview": "bun scripts/desktop/widget.ts --preview",
    "desktop:once": "bun scripts/desktop/widget.ts --once",
    "desktop:shortcut": "bun scripts/desktop/create-desktop-shortcut.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc -p apps/desktop/tsconfig.json --noEmit",
    "format": "biome format --write .",
    "check": "biome check . && tsc --noEmit && tsc -p apps/desktop/tsconfig.json --noEmit && bun test && bun scripts/tokens/check-tokens.ts",
    "widget": "bun scripts/desktop/widget.ts",
    "font": "bun scripts/install/install-nerd-font.ts",
    "font:install": "bun scripts/install/install-nerd-font.ts",
    "install:omp": "bun scripts/build/build.ts --no-desktop && bun scripts/install/install.ts",
    "monitor": "bun scripts/monitor/monitor.ts",
    "monitor:orca": "bun scripts/monitor/orca-monitor.ts",
    "reliability:report": "bun scripts/reliability/reliability-report.ts",
    "execution:report": "bun scripts/reliability/execution-report.ts",
    "doctor": "bun scripts/doctor.ts",
    "gateway": "powershell -ExecutionPolicy Bypass -File scripts/gateway/omp-gateway.ps1",
    "gateway:ctl": "bun apps/gateway/src/index.ts",
    "gateway:status": "bun scripts/gateway/doctor-gateway.ts",
    "gateway:test": "powershell -ExecutionPolicy Bypass -File scripts/gateway/omp-gateway.ps1 test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "colorjs.io": "^0.7.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2"
  }
}
