{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "border": { "$value": "ansi:240" },
    "muted": { "$value": "ansi:245" },
    "accent": { "$value": "ansi:81" },
    "ok": { "$value": "ansi:42" },
    "warn": { "$value": "ansi:220" },
    "hot": { "$value": "ansi:208" },
    "danger": { "$value": "ansi:203" }
  },
  "usage": {
    "warmThreshold": { "$value": 0.4 },
    "hotThreshold": { "$value": 0.7 },
    "criticalThreshold": { "$value": 0.85 }
  },
  "health": {
    "restoreStreak": { "$value": 3 },
    "restoreGapSeconds": { "$value": 60 },
    "staleSnapshotMinutes": { "$value": 15 }
  }
}
